---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, ADDRESS } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Service Areas | ${SITE_TITLE}`} description="Drain cleaning service areas in Sunnyvale, CA and nearby South Bay communities. Based at 1095 W Evelyn Ave #104." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Service Areas</h1>
			<p>Proudly serving Sunnyvale and surrounding South Bay neighborhoods.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Where We Work</h2>
					<p>Our primary service area is Sunnyvale, CA, with coverage extending to nearby cities in Santa Clara County. We’re based at {ADDRESS} and respond quickly across the local area.</p>
					
					<h3>Primary Coverage</h3>
					<ul>
						<li>Sunnyvale</li>
						<li>Mountain View</li>
						<li>Santa Clara</li>
						<li>Cupertino</li>
						<li>Los Altos</li>
						<li>Palo Alto</li>
						<li>Milpitas</li>
						<li>San Jose (north & west areas)</li>
					</ul>

					<p>Not sure if we cover your address? Call us — we’ll let you know right away.</p>
					<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
				</div>
				<div>
					<h3>Our Location</h3>
					<p>{ADDRESS}</p>
					<div class="map-wrapper">
						<iframe
							src="https://maps.google.com/maps?q=1095+W+Evelyn+Ave+%23104,+Sunnyvale,+CA+94086&t=&z=14&ie=UTF8&iwloc=&output=embed"
							title="Map pinpointing 1095 W Evelyn Ave #104, Sunnyvale, CA 94086"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Need Drain Service Near You?</h2>
			<p>We’re ready to help homes and businesses across Sunnyvale and the South Bay.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
