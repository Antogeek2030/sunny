---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Drain Cleaning Sunnyvale CA | ${SITE_TITLE}`} description="Professional drain cleaning in Sunnyvale, CA. Clear kitchen, bathroom, and main line drains safely and thoroughly." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Drain Cleaning in Sunnyvale</h1>
			<p>Restore full flow and stop backups with professional drain cleaning.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Thorough Drain Cleaning for Homes & Businesses</h2>
					<p>Slow drains and recurring clogs are more than an inconvenience — they can lead to costly water damage. We clean drains properly using the right tools for your pipe material and the type of blockage.</p>
					<p>Whether it’s a kitchen sink full of grease, a shower packed with hair, or a main sewer line restricted by roots or scale, we restore flow and help prevent the next backup.</p>
					
					<h3>What’s Included</h3>
					<ul>
						<li>Assessment of the affected drain or line</li>
						<li>Mechanical or hydro cleaning as appropriate</li>
						<li>Clearing of grease, hair, soap scum, and debris</li>
						<li>Recommendations to reduce future clogs</li>
						<li>Optional camera inspection for complex issues</li>
					</ul>
				</div>
				<div>
					<h3>Drains We Service</h3>
					<ul>
						<li>Kitchen sinks and disposals</li>
						<li>Bathroom sinks, showers, and tubs</li>
						<li>Toilets and floor drains</li>
						<li>Laundry and utility drains</li>
						<li>Main sewer and building lines</li>
					</ul>
					
					<h3>When to Call</h3>
					<p>Call us if water drains slowly, gurgles, or backs up; if multiple fixtures are affected; or if you’ve already tried chemical cleaners without lasting results.</p>
					
					<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
					<a href="/contact/" class="btn btn-outline" style="margin-left:0.5rem;">Request Quote</a>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Ready for Clear Drains?</h2>
			<p>Schedule professional drain cleaning in Sunnyvale today.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
