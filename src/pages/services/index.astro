---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Drain Services | ${SITE_TITLE}`} description="Professional drain cleaning, hydro jetting, camera inspection, and clog removal services in Sunnyvale, CA." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Our Drain Services</h1>
			<p>Complete drain cleaning and plumbing solutions for Sunnyvale homes and businesses.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="cards">
				<div class="card">
					<h3>Drain Cleaning</h3>
					<p>Thorough cleaning of residential and commercial drains to restore full flow and prevent future backups.</p>
					<a href="/services/drain-cleaning/">Learn more →</a>
				</div>
				<div class="card">
					<h3>Hydro Jetting</h3>
					<p>High-pressure water jetting that removes grease, scale, and debris from pipe walls for a long-lasting clean.</p>
					<a href="/services/hydro-jetting/">Learn more →</a>
				</div>
				<div class="card">
					<h3>Camera Inspection</h3>
					<p>In-pipe video inspection to diagnose clogs, damage, and root intrusion with clear visual evidence.</p>
					<a href="/services/camera-inspection/">Learn more →</a>
				</div>
				<div class="card">
					<h3>Clog Removal</h3>
					<p>Fast, effective clearing of sinks, showers, toilets, and main lines — including tough recurring clogs.</p>
					<a href="/services/clog-removal/">Learn more →</a>
				</div>
				<div class="card">
					<h3>Preventive Maintenance</h3>
					<p>Scheduled service plans that keep drains clear and reduce emergency calls for homes and commercial properties.</p>
					<a href="/services/maintenance/">Learn more →</a>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Need Help Choosing the Right Service?</h2>
			<p>Call us for a free consultation. We’ll help you decide the best path forward.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
